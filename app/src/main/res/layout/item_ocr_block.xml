<?xml version="1.0" encoding="utf-8"?>
<!-- One block of text: its words, its translation, and the details of a tapped word. -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginHorizontal="12dp"
	android:layout_marginTop="8dp"
	android:clickable="true"
	android:focusable="true"
	android:background="@drawable/bg_ocr_block"
	android:foreground="?attr/selectableItemBackground"
	android:orientation="vertical"
	android:padding="12dp">

	<io.github.nathankewley.jocr.ui.WordFlowLayout
		android:id="@+id/flow_words"
		android:layout_width="match_parent"
		android:layout_height="wrap_content" />

	<TextView
		android:id="@+id/textView_translation"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:background="@drawable/bg_ocr_translation"
		android:drawablePadding="8dp"
		android:gravity="center_vertical"
		android:minHeight="36dp"
		android:paddingHorizontal="10dp"
		android:paddingVertical="6dp"
		android:textAppearance="?attr/textAppearanceBodyMedium"
		tools:text="@string/ocr_tap_to_reveal" />

	<LinearLayout
		android:id="@+id/layout_details"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:background="@drawable/bg_card"
		android:orientation="vertical"
		android:padding="12dp"
		android:visibility="gone"
		tools:visibility="visible" />

</LinearLayout>
